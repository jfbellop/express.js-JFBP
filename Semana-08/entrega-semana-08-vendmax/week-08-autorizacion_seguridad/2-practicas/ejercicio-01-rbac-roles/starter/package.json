{
  "name": "ejercicio-01-rbac-roles",
  "version": "1.0.0",
  "description": "Ejercicio RBAC: implementar requireRole middleware",
  "main": "src/server.ts",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "mongo": "tsx src/scripts/mongo-dev.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "seed": "tsx src/scripts/seed.ts",
    "test:flow": "tsx src/scripts/test-flow.ts"
  },
  "dependencies": {
    "bcrypt": "5.1.1",
    "cookie-parser": "1.4.7",
    "dotenv": "16.5.0",
    "express": "5.1.0",
    "jsonwebtoken": "9.0.2",
    "mongoose": "9.4.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "5.0.2",
    "@types/cookie-parser": "1.4.8",
    "@types/express": "5.0.3",
    "@types/jsonwebtoken": "9.0.9",
    "@types/node": "22.15.29",
    "mongodb-memory-server": "11.3.0",
    "tsx": "4.19.4",
    "typescript": "5.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "bcrypt"
    ]
  }
}
