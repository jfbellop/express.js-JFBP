            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('allow-origin exacto', () => pm.expect(pm.response.headers.get('access-control-allow-origin')).to.eql('http://localhost:5173'));"
                ]
              }
            }
          ]
        },
