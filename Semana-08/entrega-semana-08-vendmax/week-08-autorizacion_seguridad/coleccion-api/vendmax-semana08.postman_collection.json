{
  "info": {
    "name": "VendMax API - Semana 08 (Autorizacion y Seguridad)",
    "description": "RBAC (requireRole + dueno-o-admin + visibilidad por campo) y capas de seguridad: helmet, CORS con whitelist, rate limiting, express-mongo-sanitize. Ejecutar en orden con Collection Runner. Requiere: pnpm mongo + pnpm seed + pnpm dev.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "operadorToken",
      "value": ""
    },
    {
      "key": "tecnicoToken",
      "value": ""
    },
    {
      "key": "machineId",
      "value": ""
    },
    {
      "key": "nuevaMaquinaId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Capas de seguridad",
      "item": [
        {
          "name": "00 - Health + cabeceras helmet",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Todas las cabeceras de seguridad en una sola respuesta."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('helmet: nosniff', () => pm.expect(pm.response.headers.get('x-content-type-options')).to.eql('nosniff'));",
                  "pm.test('helmet: X-Frame-Options', () => pm.expect(pm.response.headers.get('x-frame-options')).to.be.a('string'));",
                  "pm.test('helmet: HSTS', () => pm.expect(pm.response.headers.get('strict-transport-security')).to.include('max-age'));",
                  "pm.test('helmet: sin X-Powered-By', () => pm.expect(pm.response.headers.get('x-powered-by')).to.be.null);",
                  "pm.test('rate limit: RateLimit-Limit 100', () => pm.expect(pm.response.headers.get('ratelimit-limit')).to.eql('100'));",
                  "pm.test('rate limit: X-RateLimit-Remaining visible', () => pm.expect(pm.response.headers.get('x-ratelimit-remaining')).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "01 - CORS origen permitido",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Origin",
                "value": "http://localhost:5173"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/machines",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "machines"
              ]
