            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": {\n    \"$gt\": \"\"\n  },\n  \"password\": {\n    \"$gt\": \"\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('no autentica', () => pm.expect(pm.response.code).to.not.eql(200));",
                  "pm.test('sin accessToken', () => pm.expect(pm.response.text()).to.not.include('accessToken'));"
                ]
              }
            }
          ]
        }
      ]
