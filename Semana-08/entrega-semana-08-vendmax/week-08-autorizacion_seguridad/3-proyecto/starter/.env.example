# ============================================================
# VendMax API - semana 08 (RBAC + seguridad)
# ============================================================
# Este archivo NO se sube a Git (.gitignore lo excluye).
# Se entrega solo para que el evaluador pueda ejecutar el proyecto.
PORT=3000
MONGODB_URI=mongodb://localhost:27017/vendmax_semana08
NODE_ENV=development

# --- JWT: dos secretos DISTINTOS, generados al azar (48 bytes base64) ---
JWT_ACCESS_SECRET=genera_uno_con_openssl_rand_base64_48
JWT_REFRESH_SECRET=genera_OTRO_distinto_con_openssl_rand_base64_48
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- CORS: whitelist separada por comas (nunca '*') ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# --- Credenciales del seed (solo entorno de desarrollo) ---
SEED_ADMIN_EMAIL=admin@vendmax.co
SEED_ADMIN_PASSWORD=Admin1234!
SEED_OPERATOR_EMAIL=operador@vendmax.co
SEED_OPERATOR_PASSWORD=Operador1234!
