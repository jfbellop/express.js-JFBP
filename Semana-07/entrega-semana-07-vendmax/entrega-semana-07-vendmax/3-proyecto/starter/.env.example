# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Levantar la base con: docker compose up -d
MONGODB_URI=mongodb://vendmax:vendmax123@localhost:27017/vendmax_dev?authSource=admin

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generar cada uno con: openssl rand -base64 64
# IMPORTANTE: deben ser DISTINTOS entre sí (rúbrica: -15 pts si se repiten)
JWT_ACCESS_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio_access
JWT_REFRESH_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio_refresh

# ─── Credenciales del seed (scripts/seed.ts) ──────────────────────────────────
SEED_ADMIN_EMAIL=admin@vendmax.co
SEED_ADMIN_PASSWORD=Admin1234!
SEED_OPERATOR_EMAIL=operador@vendmax.co
SEED_OPERATOR_PASSWORD=Operador1234!
